{
  "name": "hourleaf",
  "version": "0.6.0",
  "description": "Local-first cross-browser website focus, planning, time insights, and optional local modules.",
  "license": "MIT",
  "keywords": [
    "browser-extension",
    "focus",
    "productivity",
    "webextension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/446F7269616E/Hourleaf.git"
  },
  "homepage": "https://github.com/446F7269616E/Hourleaf#readme",
  "bugs": {
    "url": "https://github.com/446F7269616E/Hourleaf/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:chromium": "node scripts/build.mjs chromium",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:safari": "node scripts/build.mjs safari",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "esbuild": "^0.28.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
